#!/usr/bin/env bash
# Terminal launcher for md-reader. Opens the app, or brings the running
# instance to the foreground — LaunchServices deduplicates the no-argument case.
#
# When this file lives inside a bundle (Contents/Resources, including via
# a symlink on PATH), it launches that bundle. The repo copy falls back
# to /Applications/md-reader.app, and is targeted explicitly (not `open -a`)
# so it never resolves to a stale build-output copy.
#
# With a path argument the bundle's inner binary is started directly so
# the path reaches the app's own argument parser: `open` without --args
# treats the argument as a document, and `open --args` drops it entirely
# when an instance is already running. Relative paths (e.g. `.`) are
# resolved against the caller's directory so the app receives an
# absolute path. The app's single-instance guard forwards the path to
# any running instance and exits the duplicate.
#
# That binary is detached from the terminal: its own process group, SIGHUP
# ignored, stdio discarded. The shell returns immediately, and closing the
# terminal does not quit the app.

# Resolve symlinks so a PATH entry can point at the copy inside the bundle.
SOURCE="$0"
while [ -L "$SOURCE" ]; do
  link_dir="$(cd "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  case "$SOURCE" in
    /*) ;;
    *) SOURCE="$link_dir/$SOURCE" ;;
  esac
done
SCRIPT_DIR="$(cd "$(dirname "$SOURCE")" && pwd)"
if [ -d "$SCRIPT_DIR/../MacOS" ]; then
  APP="$(cd "$SCRIPT_DIR/../.." && pwd)"
else
  APP="/Applications/md-reader.app"
fi
BIN="$APP/Contents/MacOS/md-reader"

case "${1:-}" in
  -h|--help)
    cat <<'EOF'
md-reader — markdown reader

Usage: md-reader [path]

  md-reader            Open the app, or bring a running instance to the foreground
  md-reader <path>     Open a file (with its parent folder as workspace) or a folder
  md-reader --help     Show this help
EOF
    exit 0
    ;;
esac

if [ "$#" -gt 0 ]; then
  if [ -x "$BIN" ]; then
    args=()
    for arg in "$@"; do
      case "$arg" in
        /*) args+=("$arg") ;;
        *) args+=("$(cd "$arg" 2>/dev/null && pwd || printf '%s' "$PWD/$arg")") ;;
      esac
    done
    # Monitor mode puts the app in its own process group so Ctrl-C in the
    # terminal does not reach it. nohup ignores SIGHUP when the terminal
    # closes. disown lets this script exit without waiting on the app.
    set -m
    nohup "$BIN" "${args[@]}" </dev/null >/dev/null 2>&1 &
    disown
    exit 0
  fi
  exec open -a "$APP" --args "$@"
fi

if [ -d "$APP" ]; then
  exec open "$APP"
fi
exec open -a "md-reader"
