{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "md-reader",
  "version": "0.1.0",
  "identifier": "app.mdr.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "md-reader",
        "width": 1024,
        "height": 768,
        "minWidth": 640,
        "minHeight": 480,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "cli": {
      "args": [
        {
          "name": "path",
          "index": 1,
          "takesValue": true
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "A calm, native macOS markdown reader.",
    "longDescription": "md-reader is a local-first, zero-telemetry markdown reader and editor for macOS. Read rendered documents with comfortable typography, edit the source in place, and navigate wikilinks, backlinks, an outline, and workspace-wide search — all without a database.",
    "copyright": "Copyright © 2026 Olaf Krawczyk",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
